{
  "name": "jsencrypt-ext",
  "version": "3.4.1",
  "description": "RSA long-message chunked encryption and decryption for JavaScript and TypeScript, built on JSEncrypt with UTF-8, Chinese, and Emoji support.",
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@12.18.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "README_zh.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test",
    "dev": "tsdown --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src test *.config.mjs --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "test": "pnpm build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm check"
  },
  "author": {
    "name": "bartlian"
  },
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jsencrypt": "^3.5.4",
    "prettier": "3.9.10",
    "publint": "^0.3.25",
    "tsdown": "^0.23.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bartlian/jsencrypt-ext.git"
  },
  "bugs": {
    "url": "https://github.com/bartlian/jsencrypt-ext/issues"
  },
  "homepage": "https://github.com/bartlian/jsencrypt-ext#readme",
  "keywords": [
    "rsa",
    "jsencrypt",
    "jsencrypt-extension",
    "rsa-encryption",
    "rsa-decryption",
    "rsa-long-message",
    "long-message",
    "long-text",
    "chunked-encryption",
    "chunked-decryption",
    "segmented-encryption",
    "segmented-decryption",
    "pkcs1",
    "utf8",
    "unicode",
    "emoji",
    "typescript",
    "browser",
    "nodejs",
    "miniprogram",
    "分段加密",
    "分段解密",
    "长文本加密",
    "rsa加密",
    "rsa分段加密",
    "rsa分段解密"
  ]
}
